<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.techsenger.weaverbird.it</groupId>
        <artifactId>weaverbird-it</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <groupId>com.techsenger.weaverbird.it</groupId>
    <artifactId>weaverbird-it-net</artifactId>
    <packaging>jar</packaging>
    <name>Weaverbird - IT Net</name>
    <description>Integration tests for client-server interaction</description>

    <properties>
        <failsafe.plugin.arguments>--add-opens java.base/java.time=com.techsenger.weaverbird.core --enable-native-access=com.techsenger.weaverbird.core -Dcom.techsenger.weaverbird.repo.local=file://${settings.localRepository}</failsafe.plugin.arguments>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.techsenger.toolkit</groupId>
            <artifactId>toolkit-http</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.techsenger.weaverbird</groupId>
            <artifactId>weaverbird-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.techsenger.weaverbird.net</groupId>
            <artifactId>weaverbird-net-shared</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.techsenger.weaverbird.net</groupId>
            <artifactId>weaverbird-net-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.techsenger.weaverbird.net</groupId>
            <artifactId>weaverbird-net-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.techsenger.weaverbird.it</groupId>
            <artifactId>weaverbird-it-shared</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.techsenger.weaverbird.assembly</groupId>
            <artifactId>weaverbird-assembly-security</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.techsenger.weaverbird.assembly</groupId>
                <artifactId>weaverbird-assembly-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <phase>initialize</phase>
                        <goals>
                            <goal>assemble-runtime</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <path>${project.build.directory}/framework</path>
                    <components>
                        <component>weaverbird-repo</component>
                        <component>weaverbird-server</component>
                        <component>weaverbird-cli</component>
                        <component>weaverbird-gui</component>
                    </components>
                </configuration>
            </plugin>
            <!--
                Workaround for https://bugs.openjdk.org/browse/JDK-8322302. Because of the bug the tests cannot run with
                deployed components, so they run in the boot layer, which already contains Gson (used by net-shared).
                The repo component is created above the boot layer, and its own Gson would give automatic modules two
                modules with the same name. The transformation removes Gson from the repo component configuration.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>xml-maven-plugin</artifactId>
                <version>1.2.2</version>
                <executions>
                    <execution>
                        <id>remove-repo-gson</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>transform</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <forceCreation>true</forceCreation>
                    <transformationSets>
                        <transformationSet>
                            <dir>${project.build.directory}/framework/config/weaverbird-repo/${project.version}</dir>
                            <includes>
                                <include>configuration.xml</include>
                            </includes>
                            <stylesheet>${project.basedir}/src/test/xsl/remove-repo-gson.xsl</stylesheet>
                            <outputDir>${project.build.directory}/framework/config/weaverbird-repo/${project.version}</outputDir>
                        </transformationSet>
                    </transformationSets>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>